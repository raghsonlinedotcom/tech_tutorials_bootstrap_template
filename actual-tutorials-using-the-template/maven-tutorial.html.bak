    <!-- Search Results Panel -->
    <div class="search-results-panel" id="searchResultsPanel">
        <div class="card mb-0">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-search"></i> Search Results</span>
                <button class="btn btn-sm btn-close btn-close-white" id="closeSearchPanel"></button>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <strong id="searchResultCount">0 matches</strong>
                        <div class="small text-muted" id="searchTerm"></div>
                    </div>
                </div>
                <div class="btn-group w-100" role="group">
                    <button class="btn btn-outline-primary" id="prevMatch">
                        <i class="bi bi-chevron-up"></i> Previous
                    </button>
                    <button class="btn btn-outline-primary" id="nextMatch">
                        <i class="bi bi-chevron-down"></i> Next
                    </button>
                </div>
                <div class="mt-2 text-center">
                    <small class="text-muted">Match <span id="currentMatchNum">0</span> of <span id="totalMatches">0</span></small>
                </div>
            </div>
        </div>
    </div>

    <!-- Version Badge -->
    <span class="badge bg-secondary version-badge" data-bs-toggle="tooltip" title="Tutorial Version">v1.0.0</span>

    <!-- Footer Section -->
    <footer class="mt-5 py-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-top: 5px solid #f8f9fa;">
        <div class="container">
