    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <!-- Jumbotron / Hero Section -->
                <div class="jumbotron-custom text-center" id="home">
                    <h1 class="display-3"><i class="bi bi-box-seam"></i> Apache Maven Mastery</h1>
                    <p class="lead">Master Build Automation and Dependency Management for Java Projects</p>
                    <hr class="my-4" style="border-color: rgba(255,255,255,0.3);">
                    <p>Learn Maven from fundamentals to advanced topics with a real-world Library Management System project</p>
                    <a class="btn btn-light btn-lg" href="#introduction" role="button">Get Started <i class="bi bi-arrow-right"></i></a>
                </div>

                <!-- Alert Messages -->
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> <strong>Complete Tutorial:</strong> This tutorial covers Maven 3.9+ with Java 17+, including architecture, lifecycle phases, dependency management, and a comprehensive Library Management System example.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>

                <!-- Introduction Section -->
                <div class="card mb-4" id="introduction">
                    <div class="card-header bg-primary text-white">
                        <h2><i class="bi bi-book"></i> Introduction to Apache Maven</h2>
                    </div>
                    <div class="card-body">
                        <p class="lead">Apache Maven is a powerful build automation and project management tool primarily used for Java projects. It simplifies the build process, manages dependencies, and provides a uniform build system.</p>
                        
                        <h4 class="mt-4"><i class="bi bi-lightbulb"></i> What is Apache Maven?</h4>
                        <p>Maven is based on the Project Object Model (POM) concept and provides developers with:</p>
                        <ul>
                            <li><strong>Dependency Management:</strong> Automatically download and manage project dependencies</li>
                            <li><strong>Standardized Build:</strong> Convention over configuration approach</li>
                            <li><strong>Plugin Architecture:</strong> Extend functionality through plugins</li>
                            <li><strong>Project Lifecycle:</strong> Well-defined phases for building, testing, and deploying</li>
                            <li><strong>Repository Management:</strong> Central and local repository systems</li>
                        </ul>

                        <div class="alert alert-info mt-3">
                            <i class="bi bi-info-circle"></i> <strong>Latest Version:</strong> Maven 3.9.6 (as of January 2026) with Java 17+ support. Maven 4.0 is in development with performance improvements and new features.
                        </div>

                        <h4 class="mt-4"><i class="bi bi-graph-up"></i> Why Use Maven?</h4>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card bg-light mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-speedometer2 text-success"></i> Simplified Build Process</h5>
                                        <p class="card-text">No need to write complex build scripts - Maven handles compilation, testing, packaging automatically.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-diagram-3 text-primary"></i> Dependency Management</h5>
                                        <p class="card-text">Automatic resolution and download of dependencies and transitive dependencies.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-puzzle text-warning"></i> Plugin Ecosystem</h5>
                                        <p class="card-text">Rich ecosystem of plugins for various tasks - testing, code quality, deployment, and more.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-people text-info"></i> Industry Standard</h5>
                                        <p class="card-text">Widely adopted in the Java ecosystem, making projects easy to understand and maintain.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h4 class="mt-4"><i class="bi bi-terminal"></i> Installation</h4>
                        <p>Prerequisites: Java Development Kit (JDK) 17 or higher</p>
                        
                        <div class="alert alert-warning">
                            <strong><i class="bi bi-exclamation-triangle"></i> Important:</strong> Ensure JAVA_HOME environment variable is set before installing Maven.
                        </div>

                        <pre><code class="language-bash"># Check Java version
java -version

# Download Maven (macOS with Homebrew)
brew install maven

# Or download manually from https://maven.apache.org/download.cgi
# Extract and add to PATH
export PATH=/path/to/maven/bin:$PATH

# Verify installation
mvn -version</code></pre>

                        <div class="console-output mt-3">Apache Maven 3.9.6 (bc0240f3c744dd6b6ec2920b3cd08dcc295161ae)
Maven home: /opt/homebrew/Cellar/maven/3.9.6/libexec
Java version: 17.0.9, vendor: Oracle Corporation
Java home: /Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home
Default locale: en_US, platform encoding: UTF-8
OS name: "mac os x", version: "14.2", arch: "aarch64", family: "mac"</div>
                    </div>
                </div>

                <!-- Architecture Section -->
                <div class="card mb-4" id="architecture">
                    <div class="card-header bg-success text-white">
                        <h2><i class="bi bi-diagram-3"></i> Maven Architecture</h2>
                    </div>
                    <div class="card-body">
                        <p class="lead">Maven's architecture is designed around the concept of a Project Object Model (POM), plugins, and repositories.</p>

                        <h4 class="mt-3"><i class="bi bi-diagram-2"></i> Core Components</h4>
                        
                        <!-- Tab Group for Architecture Diagrams -->
                        <ul class="nav nav-tabs" id="architectureTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="ascii-arch-tab" data-bs-toggle="tab" data-bs-target="#ascii-arch" type="button" role="tab">
                                    <i class="bi bi-code"></i> ASCII Diagram
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="plantuml-arch-tab" data-bs-toggle="tab" data-bs-target="#plantuml-arch" type="button" role="tab">
                                    <i class="bi bi-diagram-3"></i> PlantUML
                                </button>
                            </li>
                        </ul>
                        
                        <div class="tab-content border border-top-0 p-3" id="architectureTabContent">
                            <div class="tab-pane fade show active" id="ascii-arch" role="tabpanel">
                                <pre><code class="language-text">
┌─────────────────────────────────────────────────────────────┐
│                      Maven Architecture                       │
└─────────────────────────────────────────────────────────────┘

                    ┌──────────────┐
                    │   User CLI   │
                    │  mvn clean   │
                    │   package    │
                    └──────┬───────┘
                           │
                           ▼
                  ┌────────────────┐
                  │  Maven Core    │
                  │   Engine       │
                  └────────┬───────┘
                           │
           ┌───────────────┼───────────────┐
           ▼               ▼               ▼
    ┌──────────┐    ┌──────────┐   ┌──────────┐
    │   POM    │    │ Plugins  │   │Repository│
    │  Reader  │    │ Manager  │   │ Manager  │
    └────┬─────┘    └────┬─────┘   └────┬─────┘
         │               │              │
         ▼               ▼              ▼
    ┌─────────┐    ┌─────────┐   ┌──────────┐
    │ pom.xml │    │Build    │   │ Local    │
    │         │    │Lifecycle│   │Repository│
    │         │    │ Phases  │   │ ~/.m2    │
    └─────────┘    └────┬────┘   └────┬─────┘
                        │              │
                        ▼              ▼
                  ┌──────────┐   ┌──────────┐
                  │ Plugin   │   │ Central  │
                  │Execution │   │Repository│
                  │          │   │Maven     │
                  └──────────┘   │Central   │
                                 └──────────┘
</code></pre>
                            </div>
                            <div class="tab-pane fade" id="plantuml-arch" role="tabpanel">
                                <pre><code class="language-plantuml">@startuml
!theme plain

actor User
participant "Maven CLI" as CLI
participant "Maven Core" as Core
database "pom.xml" as POM
participant "Plugin Manager" as PM
participant "Repository Manager" as RM
database "Local Repository\n~/.m2" as Local
cloud "Maven Central" as Central

User -> CLI: mvn clean package
CLI -> Core: Parse command
Core -> POM: Read project configuration
Core -> PM: Load required plugins
PM -> RM: Check dependencies
RM -> Local: Search locally
alt Dependency not found
    RM -> Central: Download dependencies
    Central --> RM: Return artifacts
    RM -> Local: Cache artifacts
end
PM -> Core: Execute plugin goals
Core -> PM: Run lifecycle phases
PM --> CLI: Build result
CLI --> User: Display output

@enduml</code></pre>
                            </div>
                        </div>

                        <h4 class="mt-4"><i class="bi bi-boxes"></i> Key Architecture Elements</h4>
                        
                        <h5 class="mt-3">1. Project Object Model (POM)</h5>
                        <p>The pom.xml file is the heart of a Maven project. It contains:</p>
                        <ul>
                            <li>Project coordinates (groupId, artifactId, version)</li>
                            <li>Dependencies and their versions</li>
                            <li>Build configuration and plugins</li>
                            <li>Project properties and profiles</li>
                        </ul>

                        <h5 class="mt-3">2. Maven Repositories</h5>
                        <div class="alert alert-secondary">
                            <strong>Local Repository:</strong> <code>~/.m2/repository</code> - Caches downloaded dependencies<br>
                            <strong>Central Repository:</strong> <code>https://repo.maven.apache.org/maven2</code> - Public Maven artifacts<br>
                            <strong>Remote Repositories:</strong> Custom/private repositories (Nexus, Artifactory)
                        </div>

                        <h5 class="mt-3">3. Plugin Architecture</h5>
                        <p>Maven is essentially a plugin execution framework. Everything is done through plugins:</p>
                        <ul>
                            <li><code>maven-compiler-plugin</code> - Compiles Java source code</li>
                            <li><code>maven-surefire-plugin</code> - Runs unit tests</li>
                            <li><code>maven-jar-plugin</code> - Creates JAR files</li>
                            <li><code>maven-deploy-plugin</code> - Deploys artifacts to repositories</li>
                        </ul>

                        <h5 class="mt-3">4. Standard Directory Structure</h5>
                        <pre><code class="language-text">my-project/
├── pom.xml
├── src/
│   ├── main/
│   │   ├── java/          # Java source files
│   │   ├── resources/     # Application resources
│   │   └── webapp/        # Web application files (if applicable)
│   └── test/
│       ├── java/          # Test source files
│       └── resources/     # Test resources
└── target/                # Build output (generated)
    ├── classes/           # Compiled classes
    ├── test-classes/      # Compiled test classes
    ├── surefire-reports/  # Test reports
    └── *.jar              # Final artifact</code></pre>
                    </div>
                </div>

                <!-- Ecosystem Section -->
                <div class="card mb-4" id="ecosystem">
                    <div class="card-header bg-warning text-dark">
                        <h2><i class="bi bi-grid-3x3-gap"></i> Maven Ecosystem</h2>
                    </div>
                    <div class="card-body">
                        <p class="lead">Maven's ecosystem consists of tools, plugins, and integrations that extend its functionality.</p>

                        <h4 class="mt-3"><i class="bi bi-puzzle"></i> Essential Plugins</h4>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <h5><i class="bi bi-gear text-primary"></i> Core Build Plugins</h5>
                                <ul>
                                    <li><strong>maven-compiler-plugin</strong> - Java compilation</li>
                                    <li><strong>maven-resources-plugin</strong> - Resource copying</li>
                                    <li><strong>maven-jar-plugin</strong> - JAR packaging</li>
                                    <li><strong>maven-war-plugin</strong> - WAR packaging</li>
                                    <li><strong>maven-install-plugin</strong> - Install to local repo</li>
                                    <li><strong>maven-deploy-plugin</strong> - Deploy to remote repo</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h5><i class="bi bi-check-circle text-success"></i> Testing Plugins</h5>
                                <ul>
                                    <li><strong>maven-surefire-plugin</strong> - Unit tests</li>
                                    <li><strong>maven-failsafe-plugin</strong> - Integration tests</li>
                                    <li><strong>jacoco-maven-plugin</strong> - Code coverage</li>
                                    <li><strong>maven-surefire-report-plugin</strong> - Test reports</li>
                                </ul>

                                <h5 class="mt-3"><i class="bi bi-shield-check text-warning"></i> Code Quality</h5>
                                <ul>
                                    <li><strong>maven-checkstyle-plugin</strong> - Code style</li>
                                    <li><strong>maven-pmd-plugin</strong> - Static analysis</li>
                                    <li><strong>spotbugs-maven-plugin</strong> - Bug detection</li>
                                </ul>
                            </div>
                        </div>

                        <h4 class="mt-4"><i class="bi bi-tools"></i> Build Tools & IDEs</h4>
                        
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Tool/IDE</th>
                                        <th>Maven Integration</th>
                                        <th>Features</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>IntelliJ IDEA</strong></td>
                                        <td>Built-in</td>
                                        <td>Auto-import dependencies, lifecycle execution, POM editor</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Eclipse</strong></td>
                                        <td>M2Eclipse plugin</td>
                                        <td>Project import, dependency management, lifecycle phases</td>
                                    </tr>
                                    <tr>
                                        <td><strong>VS Code</strong></td>
                                        <td>Maven for Java extension</td>
                                        <td>Project management, dependency tree, goal execution</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Jenkins</strong></td>
                                        <td>Maven Integration Plugin</td>
                                        <td>CI/CD builds, automated testing, artifact deployment</td>
                                    </tr>
                                    <tr>
                                        <td><strong>SonarQube</strong></td>
                                        <td>SonarScanner Maven</td>
                                        <td>Code quality analysis, security scanning</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <h4 class="mt-4"><i class="bi bi-cloud-arrow-down"></i> Repository Managers</h4>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title">Nexus Repository</h5>
                                        <p class="card-text">Popular repository manager by Sonatype. Supports Maven, npm, Docker, and more.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title">JFrog Artifactory</h5>
                                        <p class="card-text">Universal artifact repository supporting multiple package formats.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title">Apache Archiva</h5>
                                        <p class="card-text">Open-source repository management focused on Maven artifacts.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Build Lifecycle Section -->
                <div class="card mb-4" id="lifecycle">
                    <div class="card-header bg-info text-white">
                        <h2><i class="bi bi-arrow-repeat"></i> Maven Build Lifecycle</h2>
                    </div>
                    <div class="card-body">
                        <p class="lead">Maven has three built-in lifecycles: <strong>default</strong> (build), <strong>clean</strong> (cleanup), and <strong>site</strong> (documentation).</p>

                        <h4 class="mt-3"><i class="bi bi-list-ol"></i> Default Lifecycle Phases</h4>
                        <p>The default lifecycle consists of 23 phases. Here are the most important ones:</p>

                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead class="table-primary">
                                    <tr>
                                        <th>Phase</th>
                                        <th>Description</th>
                                        <th>Key Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><code>validate</code></td>
                                        <td>Validate project structure</td>
                                        <td>Check if project is correct and all necessary information is available</td>
                                    </tr>
                                    <tr>
                                        <td><code>compile</code></td>
                                        <td>Compile source code</td>
                                        <td>Compile Java files from src/main/java to target/classes</td>
                                    </tr>
                                    <tr>
                                        <td><code>test</code></td>
                                        <td>Run unit tests</td>
                                        <td>Execute tests using Surefire plugin, generate reports</td>
                                    </tr>
                                    <tr>
                                        <td><code>package</code></td>
                                        <td>Create distributable format</td>
                                        <td>Package compiled code (JAR, WAR, etc.)</td>
                                    </tr>
                                    <tr>
                                        <td><code>verify</code></td>
                                        <td>Run integration tests</td>
                                        <td>Execute integration tests and quality checks</td>
                                    </tr>
                                    <tr>
                                        <td><code>install</code></td>
                                        <td>Install to local repository</td>
                                        <td>Copy artifact to ~/.m2/repository for use in other projects</td>
                                    </tr>
                                    <tr>
                                        <td><code>deploy</code></td>
                                        <td>Deploy to remote repository</td>
                                        <td>Copy artifact to remote repository for sharing</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> <strong>Important:</strong> When you execute a phase, all previous phases are executed automatically. For example, <code>mvn package</code> runs validate, compile, test, and then package.
                        </div>

                        <h4 class="mt-4"><i class="bi bi-diagram-3"></i> Lifecycle Flow Diagram</h4>
                        <pre><code class="language-text">
┌─────────────────────────────────────────────────────────────┐
│                Maven Build Lifecycle Flow                     │
└─────────────────────────────────────────────────────────────┘

    validate
       │
       ▼
    compile  ──→  src/main/java  ──→  target/classes
       │
       ▼
test-compile ──→  src/test/java  ──→  target/test-classes
       │
       ▼
     test    ──→  Run JUnit tests  ──→  target/surefire-reports
       │
       ▼
    package  ──→  Create JAR/WAR  ──→  target/*.jar
       │
       ▼
    verify   ──→  Integration tests & checks
       │
       ▼
    install  ──→  Copy to ~/.m2/repository
       │
       ▼
    deploy   ──→  Upload to remote repository
</code></pre>

                        <h4 class="mt-4"><i class="bi bi-trash"></i> Clean Lifecycle</h4>
                        <p>Removes build output from the target directory:</p>
                        <pre><code class="language-bash"># Clean the project
mvn clean

# Clean and then package
mvn clean package</code></pre>

                        <h4 class="mt-3"><i class="bi bi-file-text"></i> Site Lifecycle</h4>
                        <p>Generates project documentation and reports:</p>
                        <pre><code class="language-bash"># Generate site documentation
mvn site

# Deploy site to web server
mvn site-deploy</code></pre>

                        <h4 class="mt-4"><i class="bi bi-lightning"></i> Common Maven Commands</h4>
                        <div class="row">
                            <div class="col-md-6">
                                <pre><code class="language-bash"># Clean and compile
mvn clean compile

# Run tests
mvn test

# Skip tests during build
mvn package -DskipTests

# Run specific test
mvn test -Dtest=MyTestClass</code></pre>
                            </div>
                            <div class="col-md-6">
                                <pre><code class="language-bash"># Show dependency tree
mvn dependency:tree

# Update dependencies
mvn versions:display-dependency-updates

# Run application
mvn exec:java -Dexec.mainClass="com.example.Main"</code></pre>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- POM Structure Section -->
                <div class="card mb-4" id="pom">
                    <div class="card-header bg-danger text-white">
                        <h2><i class="bi bi-file-code"></i> POM (Project Object Model) Structure</h2>
                    </div>
                    <div class="card-body">
                        <p class="lead">The pom.xml file is the fundamental unit of work in Maven. It contains all project configuration.</p>

                        <h4 class="mt-3"><i class="bi bi-file-earmark-code"></i> Basic POM Structure</h4>
                        <pre><code class="language-xml">&amp;lt;?xml version="1.0" encoding="UTF-8"?&amp;gt;
&amp;lt;project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd"&amp;gt;
    
    &amp;lt;!-- POM model version (always 4.0.0 for Maven 3.x) --&amp;gt;
    &amp;lt;modelVersion&amp;gt;4.0.0&amp;lt;/modelVersion&amp;gt;
    
    &amp;lt;!-- Project Coordinates - Unique identifier --&amp;gt;
    &amp;lt;groupId&amp;gt;com.example&amp;lt;/groupId&amp;gt;
    &amp;lt;artifactId&amp;gt;my-project&amp;lt;/artifactId&amp;gt;
    &amp;lt;version&amp;gt;1.0.0&amp;lt;/version&amp;gt;
    &amp;lt;packaging&amp;gt;jar&amp;lt;/packaging&amp;gt;
    
    &amp;lt;!-- Project Information --&amp;gt;
    &amp;lt;name&amp;gt;My Project&amp;lt;/name&amp;gt;
    &amp;lt;description&amp;gt;A sample Maven project&amp;lt;/description&amp;gt;
    &amp;lt;url&amp;gt;https://example.com/my-project&amp;lt;/url&amp;gt;
    
    &amp;lt;!-- Properties --&amp;gt;
    &amp;lt;properties&amp;gt;
        &amp;lt;project.build.sourceEncoding&amp;gt;UTF-8&amp;lt;/project.build.sourceEncoding&amp;gt;
        &amp;lt;maven.compiler.source&amp;gt;17&amp;lt;/maven.compiler.source&amp;gt;
        &amp;lt;maven.compiler.target&amp;gt;17&amp;lt;/maven.compiler.target&amp;gt;
        &amp;lt;junit.version&amp;gt;5.10.1&amp;lt;/junit.version&amp;gt;
    &amp;lt;/properties&amp;gt;
    
    &amp;lt;!-- Dependencies --&amp;gt;
    &amp;lt;dependencies&amp;gt;
        &amp;lt;dependency&amp;gt;
            &amp;lt;groupId&amp;gt;org.junit.jupiter&amp;lt;/groupId&amp;gt;
            &amp;lt;artifactId&amp;gt;junit-jupiter&amp;lt;/artifactId&amp;gt;
            &amp;lt;version&amp;gt;${junit.version}&amp;lt;/version&amp;gt;
            &amp;lt;scope&amp;gt;test&amp;lt;/scope&amp;gt;
        &amp;lt;/dependency&amp;gt;
    &amp;lt;/dependencies&amp;gt;
    
    &amp;lt;!-- Build Configuration --&amp;gt;
    &amp;lt;build&amp;gt;
        &amp;lt;plugins&amp;gt;
            &amp;lt;plugin&amp;gt;
                &amp;lt;groupId&amp;gt;org.apache.maven.plugins&amp;lt;/groupId&amp;gt;
                &amp;lt;artifactId&amp;gt;maven-compiler-plugin&amp;lt;/artifactId&amp;gt;
                &amp;lt;version&amp;gt;3.11.0&amp;lt;/version&amp;gt;
                &amp;lt;configuration&amp;gt;
                    &amp;lt;source&amp;gt;17&amp;lt;/source&amp;gt;
                    &amp;lt;target&amp;gt;17&amp;lt;/target&amp;gt;
                &amp;lt;/configuration&amp;gt;
            &amp;lt;/plugin&amp;gt;
        &amp;lt;/plugins&amp;gt;
    &amp;lt;/build&amp;gt;
    
&amp;lt;/project&amp;gt;</code></pre>

                        <h4 class="mt-4"><i class="bi bi-key"></i> Key POM Elements</h4>
                        
                        <h5 class="mt-3">1. Project Coordinates (GAV)</h5>
                        <ul>
                            <li><strong>groupId:</strong> Organization/company identifier (reverse domain)</li>
                            <li><strong>artifactId:</strong> Project name (unique within group)</li>
                            <li><strong>version:</strong> Project version (MAJOR.MINOR.PATCH)</li>
                        </ul>

                        <h5 class="mt-3">2. Dependency Scopes</h5>
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Scope</th>
                                        <th>Description</th>
                                        <th>Example</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><code>compile</code></td>
                                        <td>Default scope, available everywhere</td>
                                        <td>Spring Framework, Apache Commons</td>
                                    </tr>
                                    <tr>
                                        <td><code>test</code></td>
                                        <td>Only for testing phase</td>
                                        <td>JUnit, Mockito</td>
                                    </tr>
                                    <tr>
                                        <td><code>provided</code></td>
                                        <td>Provided by runtime (not packaged)</td>
                                        <td>Servlet API (provided by server)</td>
                                    </tr>
                                    <tr>
                                        <td><code>runtime</code></td>
                                        <td>Not needed for compilation, only runtime</td>
                                        <td>JDBC drivers</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <h5 class="mt-3">3. Parent POM & Inheritance</h5>
                        <p>Projects can inherit from a parent POM to share configuration:</p>
                        <pre><code class="language-xml">&lt;parent&gt;
    &lt;groupId&gt;org.springframework.boot&lt;/groupId&gt;
    &lt;artifactId&gt;spring-boot-starter-parent&lt;/artifactId&gt;
    &lt;version&gt;3.2.1&lt;/version&gt;
&lt;/parent&gt;</code></pre>

                        <h5 class="mt-3">4. Dependency Management</h5>
                        <p>Define versions centrally without adding dependencies:</p>
                        <pre><code class="language-xml">&lt;dependencyManagement&gt;
    &lt;dependencies&gt;
        &lt;dependency&gt;
            &lt;groupId&gt;org.junit&lt;/groupId&gt;
            &lt;artifactId&gt;junit-bom&lt;/artifactId&gt;
            &lt;version&gt;5.10.1&lt;/version&gt;
            &lt;type&gt;pom&lt;/type&gt;
            &lt;scope&gt;import&lt;/scope&gt;
        &lt;/dependency&gt;
    &lt;/dependencies&gt;
&lt;/dependencyManagement&gt;</code></pre>
                    </div>
                </div>

                <!-- Real-Time Example Section -->
                <div class="card mb-4" id="real-time-example">
                    <div class="card-header bg-primary text-white">
                        <h2><i class="bi bi-code-square"></i> Real-Time Example: Library Management System</h2>
                    </div>
                    <div class="card-body">
                        <p class="lead">Let's build a complete Library Management System demonstrating Maven lifecycle, testing, and dependencies.</p>

                        <div class="alert alert-success">
                            <h5><i class="bi bi-info-circle"></i> Project Overview</h5>
                            <p><strong>Features:</strong></p>
                            <ul class="mb-0">
                                <li>Book management (add, search, borrow, return)</li>
                                <li>User management</li>
                                <li>File-based persistence (JSON)</li>
                                <li>Comprehensive unit tests with JUnit 5</li>
                                <li>Code coverage with JaCoCo</li>
                                <li>Logging with SLF4J and Logback</li>
                            </ul>
                        </div>

                        <h4 class="mt-4"><i class="bi bi-file-code"></i> Step 1: Project Structure</h4>
                        <pre><code class="language-text">library-management-system/
├── pom.xml
├── src/
│   ├── main/
│   │   ├── java/
│   │   │   └── com/
│   │   │       └── library/
│   │   │           ├── Main.java
│   │   │           ├── model/
│   │   │           │   ├── Book.java
│   │   │           │   └── User.java
│   │   │           ├── service/
│   │   │           │   ├── LibraryService.java
│   │   │           │   └── StorageService.java
│   │   │           └── exception/
│   │   │               └── LibraryException.java
│   │   └── resources/
│   │       └── logback.xml
│   └── test/
│       ├── java/
│       │   └── com/
│       │       └── library/
│       │           ├── service/
│       │           │   └── LibraryServiceTest.java
│       │           └── model/
│       │               └── BookTest.java
│       └── resources/
│           └── test-data.json
└── target/
    ├── classes/
    ├── test-classes/
    ├── surefire-reports/
    └── library-management-system-1.0.0.jar</code></pre>

                        <h4 class="mt-4"><i class="bi bi-file-earmark-code"></i> Step 2: pom.xml Configuration</h4>
                        <pre><code class="language-xml">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd"&gt;
    &lt;modelVersion&gt;4.0.0&lt;/modelVersion&gt;
    
    &lt;groupId&gt;com.library&lt;/groupId&gt;
    &lt;artifactId&gt;library-management-system&lt;/artifactId&gt;
    &lt;version&gt;1.0.0&lt;/version&gt;
    &lt;packaging&gt;jar&lt;/packaging&gt;
    
    &lt;name&gt;Library Management System&lt;/name&gt;
    &lt;description&gt;A comprehensive library management system built with Maven&lt;/description&gt;
    
    &lt;properties&gt;
        &lt;project.build.sourceEncoding&gt;UTF-8&lt;/project.build.sourceEncoding&gt;
        &lt;maven.compiler.source&gt;17&lt;/maven.compiler.source&gt;
        &lt;maven.compiler.target&gt;17&lt;/maven.compiler.target&gt;
        
        &lt;!-- Dependency versions --&gt;
        &lt;junit.version&gt;5.10.1&lt;/junit.version&gt;
        &lt;jackson.version&gt;2.16.1&lt;/jackson.version&gt;
        &lt;slf4j.version&gt;2.0.9&lt;/slf4j.version&gt;
        &lt;logback.version&gt;1.4.14&lt;/logback.version&gt;
        &lt;lombok.version&gt;1.18.30&lt;/lombok.version&gt;
    &lt;/properties&gt;
    
    &lt;dependencies&gt;
        &lt;!-- JSON Processing --&gt;
        &lt;dependency&gt;
            &lt;groupId&gt;com.fasterxml.jackson.core&lt;/groupId&gt;
            &lt;artifactId&gt;jackson-databind&lt;/artifactId&gt;
            &lt;version&gt;${jackson.version}&lt;/version&gt;
        &lt;/dependency&gt;
        
        &lt;!-- Logging --&gt;
        &lt;dependency&gt;
            &lt;groupId&gt;org.slf4j&lt;/groupId&gt;
            &lt;artifactId&gt;slf4j-api&lt;/artifactId&gt;
            &lt;version&gt;${slf4j.version}&lt;/version&gt;
        &lt;/dependency&gt;
        &lt;dependency&gt;
            &lt;groupId&gt;ch.qos.logback&lt;/groupId&gt;
            &lt;artifactId&gt;logback-classic&lt;/artifactId&gt;
            &lt;version&gt;${logback.version}&lt;/version&gt;
        &lt;/dependency&gt;
        
        &lt;!-- Lombok for reducing boilerplate --&gt;
        &lt;dependency&gt;
            &lt;groupId&gt;org.projectlombok&lt;/groupId&gt;
            &lt;artifactId&gt;lombok&lt;/artifactId&gt;
            &lt;version&gt;${lombok.version}&lt;/version&gt;
            &lt;scope&gt;provided&lt;/scope&gt;
        &lt;/dependency&gt;
        
        &lt;!-- Testing --&gt;
        &lt;dependency&gt;
            &lt;groupId&gt;org.junit.jupiter&lt;/groupId&gt;
            &lt;artifactId&gt;junit-jupiter&lt;/artifactId&gt;
            &lt;version&gt;${junit.version}&lt;/version&gt;
            &lt;scope&gt;test&lt;/scope&gt;
        &lt;/dependency&gt;
        &lt;dependency&gt;
            &lt;groupId&gt;org.mockito&lt;/groupId&gt;
            &lt;artifactId&gt;mockito-core&lt;/artifactId&gt;
            &lt;version&gt;5.8.0&lt;/version&gt;
            &lt;scope&gt;test&lt;/scope&gt;
        &lt;/dependency&gt;
    &lt;/dependencies&gt;
    
    &lt;build&gt;
        &lt;plugins&gt;
            &lt;!-- Compiler Plugin --&gt;
            &lt;plugin&gt;
                &lt;groupId&gt;org.apache.maven.plugins&lt;/groupId&gt;
                &lt;artifactId&gt;maven-compiler-plugin&lt;/artifactId&gt;
                &lt;version&gt;3.11.0&lt;/version&gt;
                &lt;configuration&gt;
                    &lt;source&gt;17&lt;/source&gt;
                    &lt;target&gt;17&lt;/target&gt;
                &lt;/configuration&gt;
            &lt;/plugin&gt;
            
            &lt;!-- Surefire Plugin for Unit Tests --&gt;
            &lt;plugin&gt;
                &lt;groupId&gt;org.apache.maven.plugins&lt;/groupId&gt;
                &lt;artifactId&gt;maven-surefire-plugin&lt;/artifactId&gt;
                &lt;version&gt;3.2.3&lt;/version&gt;
                &lt;configuration&gt;
                    &lt;includes&gt;
                        &lt;include&gt;**/*Test.java&lt;/include&gt;
                    &lt;/includes&gt;
                &lt;/configuration&gt;
            &lt;/plugin&gt;
            
            &lt;!-- JaCoCo for Code Coverage --&gt;
            &lt;plugin&gt;
                &lt;groupId&gt;org.jacoco&lt;/groupId&gt;
                &lt;artifactId&gt;jacoco-maven-plugin&lt;/artifactId&gt;
                &lt;version&gt;0.8.11&lt;/version&gt;
                &lt;executions&gt;
                    &lt;execution&gt;
                        &lt;goals&gt;
                            &lt;goal&gt;prepare-agent&lt;/goal&gt;
                        &lt;/goals&gt;
                    &lt;/execution&gt;
                    &lt;execution&gt;
                        &lt;id&gt;report&lt;/id&gt;
                        &lt;phase&gt;test&lt;/phase&gt;
                        &lt;goals&gt;
                            &lt;goal&gt;report&lt;/goal&gt;
                        &lt;/goals&gt;
                    &lt;/execution&gt;
                &lt;/executions&gt;
            &lt;/plugin&gt;
            
            &lt;!-- JAR Plugin with Main Class --&gt;
            &lt;plugin&gt;
                &lt;groupId&gt;org.apache.maven.plugins&lt;/groupId&gt;
                &lt;artifactId&gt;maven-jar-plugin&lt;/artifactId&gt;
                &lt;version&gt;3.3.0&lt;/version&gt;
                &lt;configuration&gt;
                    &lt;archive&gt;
                        &lt;manifest&gt;
                            &lt;mainClass&gt;com.library.Main&lt;/mainClass&gt;
                        &lt;/manifest&gt;
                    &lt;/archive&gt;
                &lt;/configuration&gt;
            &lt;/plugin&gt;
        &lt;/plugins&gt;
    &lt;/build&gt;
    
&lt;/project&gt;</code></pre>

                        <h4 class="mt-4"><i class="bi bi-code-slash"></i> Step 3: Source Code Files</h4>
                        
                        <!-- Code Explanations Accordion -->
                        <div class="accordion mt-3" id="codeExplanationsAccordion">
                            <!-- Book Model -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#bookModel">
                                        <i class="bi bi-book me-2"></i> <strong>Book.java - Book Model Class</strong>
                                    </button>
                                </h2>
                                <div id="bookModel" class="accordion-collapse collapse show" data-bs-parent="#codeExplanationsAccordion">
                                    <div class="accordion-body">
                                        <p>The Book class represents a book entity with all relevant properties.</p>
                                        <pre><code class="language-java">package com.library.model;

import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

import java.time.LocalDate;

/**
 * Represents a book in the library system.
 * Uses Lombok annotations to reduce boilerplate code.
 */
@Data
@NoArgsConstructor
@AllArgsConstructor
public class Book {
    private String isbn;
    private String title;
    private String author;
    private String category;
    private int publicationYear;
    private boolean available;
    private String borrowedBy;
    private LocalDate borrowedDate;
    
    /**
     * Constructor for creating a new book (initially available)
     */
    public Book(String isbn, String title, String author, String category, int publicationYear) {
        this.isbn = isbn;
        this.title = title;
        this.author = author;
        this.category = category;
        this.publicationYear = publicationYear;
        this.available = true;
    }
    
    /**
     * Mark book as borrowed by a user
     */
    public void borrow(String userId) {
        this.available = false;
        this.borrowedBy = userId;
        this.borrowedDate = LocalDate.now();
    }
    
    /**
     * Mark book as returned
     */
    public void returnBook() {
        this.available = true;
        this.borrowedBy = null;
        this.borrowedDate = null;
    }
}</code></pre>
                                        <div class="alert alert-info mt-3">
                                            <h6><i class="bi bi-lightbulb"></i> Key Points:</h6>
                                            <ul class="mb-0">
                                                <li><strong>@Data:</strong> Lombok generates getters, setters, toString, equals, and hashCode</li>
                                                <li><strong>@NoArgsConstructor/@AllArgsConstructor:</strong> Generate constructors</li>
                                                <li><strong>Business methods:</strong> borrow() and returnBook() manage book state</li>
                                                <li><strong>LocalDate:</strong> Java 8+ date API for tracking borrow dates</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- User Model -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#userModel">
                                        <i class="bi bi-person me-2"></i> <strong>User.java - User Model Class</strong>
                                    </button>
                                </h2>
                                <div id="userModel" class="accordion-collapse collapse" data-bs-parent="#codeExplanationsAccordion">
                                    <div class="accordion-body">
                                        <p>The User class represents a library user/member.</p>
                                        <pre><code class="language-java">package com.library.model;

import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

import java.util.ArrayList;
import java.util.List;

/**
 * Represents a library user/member
 */
@Data
@NoArgsConstructor
@AllArgsConstructor
public class User {
    private String userId;
    private String name;
    private String email;
    private String phone;
    private List<String> borrowedBooks;
    
    /**
     * Constructor for creating a new user
     */
    public User(String userId, String name, String email, String phone) {
        this.userId = userId;
        this.name = name;
        this.email = email;
        this.phone = phone;
        this.borrowedBooks = new ArrayList<>();
    }
    
    /**
     * Add a borrowed book to user's list
     */
    public void addBorrowedBook(String isbn) {
        if (borrowedBooks == null) {
            borrowedBooks = new ArrayList<>();
        }
        borrowedBooks.add(isbn);
    }
    
    /**
     * Remove a returned book from user's list
     */
    public void removeBorrowedBook(String isbn) {
        if (borrowedBooks != null) {
            borrowedBooks.remove(isbn);
        }
    }
    
    /**
     * Check if user can borrow more books (limit: 5 books)
     */
    public boolean canBorrowMore() {
        return borrowedBooks == null || borrowedBooks.size() < 5;
    }
}</code></pre>
                                        <div class="alert alert-info mt-3">
                                            <h6><i class="bi bi-lightbulb"></i> Key Points:</h6>
                                            <ul class="mb-0">
                                                <li><strong>borrowedBooks:</strong> Tracks ISBNs of books currently borrowed</li>
                                                <li><strong>canBorrowMore():</strong> Business rule limiting books to 5 per user</li>
                                                <li><strong>Defensive programming:</strong> Null checks in methods</li>
                                            </ul>
                                        </div>
