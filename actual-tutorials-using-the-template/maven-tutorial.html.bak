                            <!-- Logback Configuration -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#logbackConfig">
                                        <i class="bi bi-file-text me-2"></i> <strong>logback.xml - Logging Configuration</strong>
                                    </button>
                                </h2>
                                <div id="logbackConfig" class="accordion-collapse collapse" data-bs-parent="#codeExplanationsAccordion">
                                    <div class="accordion-body">
                                        <p>Logback configuration for application logging.</p>
                                        <pre><code class="language-xml">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;configuration&gt;
    
    &lt;!-- Console appender --&gt;
    &lt;appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender"&gt;
        &lt;encoder&gt;
            &lt;pattern&gt;%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n&lt;/pattern&gt;
        &lt;/encoder&gt;
    &lt;/appender&gt;
    
    &lt;!-- File appender --&gt;
    &lt;appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender"&gt;
        &lt;file&gt;logs/library.log&lt;/file&gt;
        &lt;rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy"&gt;
            &lt;fileNamePattern&gt;logs/library.%d{yyyy-MM-dd}.log&lt;/fileNamePattern&gt;
            &lt;maxHistory&gt;30&lt;/maxHistory&gt;
        &lt;/rollingPolicy&gt;
        &lt;encoder&gt;
            &lt;pattern&gt;%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n&lt;/pattern&gt;
        &lt;/encoder&gt;
    &lt;/appender&gt;
    
    &lt;!-- Root logger --&gt;
    &lt;root level="INFO"&gt;
        &lt;appender-ref ref="CONSOLE" /&gt;
        &lt;appender-ref ref="FILE" /&gt;
    &lt;/root&gt;
    
    &lt;!-- Library package logging --&gt;
    &lt;logger name="com.library" level="DEBUG" additivity="false"&gt;
        &lt;appender-ref ref="CONSOLE" /&gt;
        &lt;appender-ref ref="FILE" /&gt;
    &lt;/logger&gt;
    
&lt;/configuration&gt;</code></pre>
                                        <div class="alert alert-info mt-3">
                                            <h6><i class="bi bi-lightbulb"></i> Key Points:</h6>
                                            <ul class="mb-0">
                                                <li><strong>Console appender:</strong> Real-time logging to console</li>
                                                <li><strong>File appender:</strong> Persistent logs with rolling policy</li>
                                                <li><strong>Log patterns:</strong> Timestamp, thread, level, logger, message</li>
                                                <li><strong>Package-specific logging:</strong> DEBUG level for com.library</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h4 class="mt-4"><i class="bi bi-play-circle"></i> Step 4: Building and Running</h4>
                        
                        <h5 class="mt-3">Maven Lifecycle Execution</h5>
                        <pre><code class="language-bash"># Clean previous builds
mvn clean

# Compile source code
mvn compile

# Run tests
mvn test

# Package as JAR
mvn package

# Run the application
java -jar target/library-management-system-1.0.0.jar</code></pre>

