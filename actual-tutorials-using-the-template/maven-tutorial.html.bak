                            <!-- Test Class -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#testClass">
                                        <i class="bi bi-check2-square me-2"></i> <strong>LibraryServiceTest.java - Unit Tests</strong>
                                    </button>
                                </h2>
                                <div id="testClass" class="accordion-collapse collapse" data-bs-parent="#codeExplanationsAccordion">
                                    <div class="accordion-body">
                                        <p>Comprehensive unit tests using JUnit 5.</p>
                                        <pre><code class="language-java">package com.library.service;

import com.library.exception.LibraryException;
import com.library.model.Book;
import com.library.model.User;
import org.junit.jupiter.api.*;

import java.util.List;

import static org.junit.jupiter.api.Assertions.*;

/**
 * Unit tests for LibraryService
 */
@TestMethodOrder(MethodOrderer.OrderAnnotation.class)
class LibraryServiceTest {
    
    private LibraryService library;
    private Book sampleBook;
    private User sampleUser;
    
    @BeforeEach
    void setUp() {
        library = new LibraryService();
        sampleBook = new Book("978-0134685991", "Effective Java", "Joshua Bloch", "Programming", 2018);
        sampleUser = new User("U001", "Test User", "test@example.com", "555-0000");
    }
    
    @Test
    @Order(1)
    @DisplayName("Add book successfully")
    void testAddBook() throws LibraryException {
        library.addBook(sampleBook);
        assertEquals(1, library.getAllBooks().size());
        assertTrue(library.findBookByIsbn("978-0134685991").isPresent());
    }
    
    @Test
    @Order(2)
    @DisplayName("Cannot add duplicate book")
    void testAddDuplicateBook() throws LibraryException {
        library.addBook(sampleBook);
        
        LibraryException exception = assertThrows(LibraryException.class, () -> {
            library.addBook(sampleBook);
        });
        
        assertTrue(exception.getMessage().contains("already exists"));
    }
    
    @Test
    @Order(3)
    @DisplayName("Add user successfully")
    void testAddUser() throws LibraryException {
        library.addUser(sampleUser);
        assertEquals(1, library.getAllUsers().size());
        assertTrue(library.findUserById("U001").isPresent());
    }
    
    @Test
    @Order(4)
    @DisplayName("Search books by title")
    void testSearchBooksByTitle() throws LibraryException {
        library.addBook(sampleBook);
        library.addBook(new Book("978-0596009205", "Head First Java", "Kathy Sierra", "Programming", 2005));
        
        List<Book> results = library.searchBooksByTitle("Java");
        assertEquals(2, results.size());
    }
    
    @Test
    @Order(5)
    @DisplayName("Search books by author")
    void testSearchBooksByAuthor() throws LibraryException {
        library.addBook(sampleBook);
        
        List<Book> results = library.searchBooksByAuthor("Bloch");
        assertEquals(1, results.size());
        assertEquals("Joshua Bloch", results.get(0).getAuthor());
    }
    
    @Test
    @Order(6)
    @DisplayName("Borrow book successfully")
    void testBorrowBook() throws LibraryException {
        library.addBook(sampleBook);
        library.addUser(sampleUser);
        
        library.borrowBook("978-0134685991", "U001");
        
        Book book = library.findBookByIsbn("978-0134685991").get();
        assertFalse(book.isAvailable());
        assertEquals("U001", book.getBorrowedBy());
        
        User user = library.findUserById("U001").get();
        assertEquals(1, user.getBorrowedBooks().size());
    }
    
    @Test
    @Order(7)
    @DisplayName("Cannot borrow unavailable book")
    void testBorrowUnavailableBook() throws LibraryException {
        library.addBook(sampleBook);
        library.addUser(sampleUser);
        library.addUser(new User("U002", "User 2", "user2@example.com", "555-0002"));
        
        library.borrowBook("978-0134685991", "U001");
        
        LibraryException exception = assertThrows(LibraryException.class, () -> {
            library.borrowBook("978-0134685991", "U002");
        });
        
        assertTrue(exception.getMessage().contains("not available"));
    }
    
    @Test
    @Order(8)
    @DisplayName("Return book successfully")
    void testReturnBook() throws LibraryException {
        library.addBook(sampleBook);
        library.addUser(sampleUser);
        
        library.borrowBook("978-0134685991", "U001");
        library.returnBook("978-0134685991");
        
        Book book = library.findBookByIsbn("978-0134685991").get();
        assertTrue(book.isAvailable());
        assertNull(book.getBorrowedBy());
        
        User user = library.findUserById("U001").get();
        assertEquals(0, user.getBorrowedBooks().size());
    }
    
    @Test
    @Order(9)
    @DisplayName("User borrowing limit")
    void testUserBorrowingLimit() throws LibraryException {
        library.addUser(sampleUser);
        
        // Add 6 books
        for (int i = 1; i <= 6; i++) {
            library.addBook(new Book("ISBN-" + i, "Book " + i, "Author", "Category", 2020));
        }
        
        // Borrow 5 books (should succeed)
        for (int i = 1; i <= 5; i++) {
            library.borrowBook("ISBN-" + i, "U001");
        }
        
        // Try to borrow 6th book (should fail)
        LibraryException exception = assertThrows(LibraryException.class, () -> {
            library.borrowBook("ISBN-6", "U001");
        });
        
        assertTrue(exception.getMessage().contains("borrowing limit"));
    }
    
    @Test
    @Order(10)
    @DisplayName("Get available books")
    void testGetAvailableBooks() throws LibraryException {
        library.addBook(sampleBook);
        library.addBook(new Book("978-0132350884", "Clean Code", "Robert Martin", "Programming", 2008));
        library.addUser(sampleUser);
        
        assertEquals(2, library.getAvailableBooks().size());
        
        library.borrowBook("978-0134685991", "U001");
        
        assertEquals(1, library.getAvailableBooks().size());
    }
    
    @Test
    @Order(11)
    @DisplayName("Get statistics")
    void testGetStatistics() throws LibraryException {
        library.addBook(sampleBook);
        library.addUser(sampleUser);
        
        String stats = library.getStatistics();
        assertTrue(stats.contains("Total Books: 1"));
        assertTrue(stats.contains("Available: 1"));
        assertTrue(stats.contains("Borrowed: 0"));
        assertTrue(stats.contains("Total Users: 1"));
    }
}</code></pre>
                                        <div class="alert alert-info mt-3">
                                            <h6><i class="bi bi-lightbulb"></i> Key Points:</h6>
                                            <ul class="mb-0">
                                                <li><strong>JUnit 5 annotations:</strong> @Test, @BeforeEach, @DisplayName</li>
                                                <li><strong>Test organization:</strong> @TestMethodOrder for predictable execution</li>
                                                <li><strong>Assertions:</strong> assertEquals, assertTrue, assertThrows</li>
                                                <li><strong>Coverage:</strong> Tests all major functionality and edge cases</li>
                                                <li><strong>Descriptive names:</strong> Clear test purpose and expectations</li>
                                            </ul>
