                <div class="col-md-4 text-md-end">
                    <div class="d-flex align-items-center justify-content-md-end">
                        <div class="me-3">
                            <i class="bi bi-cpu" style="font-size: 2.5rem; color: #ffd700;"></i>
                        </div>
                        <div>
                            <h6 class="mb-1" style="color: #ffffff; font-weight: 600;">
                                <i class="bi bi-robot me-1"></i>AI Assisted
                            </h6>
                            <p class="mb-0" style="color: #f8f9fa; font-size: 0.95rem;">
