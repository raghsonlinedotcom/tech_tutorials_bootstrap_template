                            <!-- Storage Service -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#storageService">
                                        <i class="bi bi-database me-2"></i> <strong>StorageService.java - Data Persistence</strong>
                                    </button>
                                </h2>
                                <div id="storageService" class="accordion-collapse collapse" data-bs-parent="#codeExplanationsAccordion">
                                    <div class="accordion-body">
                                        <p>Service for persisting data to JSON files using Jackson.</p>
                                        <pre><code class="language-java">package com.library.service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.SerializationFeature;
import com.fasterxml.jackson.datatype.jsr310.JavaTimeModule;
import com.library.exception.LibraryException;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.io.File;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

/**
 * Service for storing and retrieving data from JSON files
 */
public class StorageService<T> {
    private static final Logger logger = LoggerFactory.getLogger(StorageService.class);
    private final ObjectMapper objectMapper;
    private final Class<T> type;
    
    public StorageService(Class<T> type) {
        this.type = type;
        this.objectMapper = new ObjectMapper();
        // Enable Java 8 date/time support
        this.objectMapper.registerModule(new JavaTimeModule());
        this.objectMapper.enable(SerializationFeature.INDENT_OUTPUT);
    }
    
    /**
     * Save list of objects to a JSON file
     */
    public void save(List<T> items, String filePath) throws LibraryException {
        try {
            File file = new File(filePath);
            file.getParentFile().mkdirs(); // Create directories if needed
            objectMapper.writeValue(file, items);
            logger.info("Saved {} items to {}", items.size(), filePath);
        } catch (IOException e) {
            logger.error("Failed to save data to {}", filePath, e);
            throw new LibraryException("Failed to save data", e);
        }
    }
    
    /**
     * Load list of objects from a JSON file
     */
    public List<T> load(String filePath) throws LibraryException {
        try {
            File file = new File(filePath);
            if (!file.exists()) {
                logger.warn("File {} does not exist, returning empty list", filePath);
                return new ArrayList<>();
            }
            
            List<T> items = objectMapper.readValue(
                file,
                objectMapper.getTypeFactory().constructCollectionType(List.class, type)
            );
            logger.info("Loaded {} items from {}", items.size(), filePath);
            return items;
        } catch (IOException e) {
            logger.error("Failed to load data from {}", filePath, e);
            throw new LibraryException("Failed to load data", e);
        }
    }
}</code></pre>
                                        <div class="alert alert-info mt-3">
                                            <h6><i class="bi bi-lightbulb"></i> Key Points:</h6>
                                            <ul class="mb-0">
                                                <li><strong>Generic class:</strong> Works with any type (Book, User)</li>
                                                <li><strong>Jackson ObjectMapper:</strong> Handles JSON serialization/deserialization</li>
                                                <li><strong>JavaTimeModule:</strong> Support for LocalDate serialization</li>
                                                <li><strong>SLF4J logging:</strong> Structured logging throughout</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Library Service -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#libraryService">
                                        <i class="bi bi-gear me-2"></i> <strong>LibraryService.java - Core Business Logic</strong>
                                    </button>
                                </h2>
                                <div id="libraryService" class="accordion-collapse collapse" data-bs-parent="#codeExplanationsAccordion">
                                    <div class="accordion-body">
                                        <p>Main service containing library operations.</p>
                                        <pre><code class="language-java">package com.library.service;

import com.library.exception.LibraryException;
import com.library.model.Book;
import com.library.model.User;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.util.ArrayList;
import java.util.List;
import java.util.Optional;
import java.util.stream.Collectors;

/**
 * Core library service with business logic
 */
public class LibraryService {
    private static final Logger logger = LoggerFactory.getLogger(LibraryService.class);
    private static final String BOOKS_FILE = "data/books.json";
    private static final String USERS_FILE = "data/users.json";
    
    private List<Book> books;
    private List<User> users;
    private final StorageService<Book> bookStorage;
    private final StorageService<User> userStorage;
    
    public LibraryService() {
        this.books = new ArrayList<>();
        this.users = new ArrayList<>();
        this.bookStorage = new StorageService<>(Book.class);
        this.userStorage = new StorageService<>(User.class);
    }
    
    /**
     * Load data from storage
     */
    public void loadData() throws LibraryException {
        this.books = bookStorage.load(BOOKS_FILE);
        this.users = userStorage.load(USERS_FILE);
        logger.info("Loaded {} books and {} users", books.size(), users.size());
    }
    
    /**
     * Save data to storage
     */
    public void saveData() throws LibraryException {
        bookStorage.save(books, BOOKS_FILE);
        userStorage.save(users, USERS_FILE);
        logger.info("Saved {} books and {} users", books.size(), users.size());
    }
    
    /**
     * Add a new book to the library
     */
    public void addBook(Book book) throws LibraryException {
        if (findBookByIsbn(book.getIsbn()).isPresent()) {
            throw new LibraryException("Book with ISBN " + book.getIsbn() + " already exists");
        }
        books.add(book);
        logger.info("Added book: {}", book.getTitle());
    }
    
    /**
     * Register a new user
     */
    public void addUser(User user) throws LibraryException {
        if (findUserById(user.getUserId()).isPresent()) {
            throw new LibraryException("User with ID " + user.getUserId() + " already exists");
        }
        users.add(user);
        logger.info("Registered user: {}", user.getName());
    }
    
    /**
     * Find book by ISBN
     */
    public Optional<Book> findBookByIsbn(String isbn) {
        return books.stream()
                .filter(book -> book.getIsbn().equals(isbn))
                .findFirst();
    }
    
    /**
     * Find user by ID
     */
    public Optional<User> findUserById(String userId) {
        return users.stream()
                .filter(user -> user.getUserId().equals(userId))
                .findFirst();
    }
    
    /**
     * Search books by title (case-insensitive partial match)
     */
    public List<Book> searchBooksByTitle(String title) {
        return books.stream()
                .filter(book -> book.getTitle().toLowerCase().contains(title.toLowerCase()))
                .collect(Collectors.toList());
    }
    
    /**
     * Search books by author
     */
    public List<Book> searchBooksByAuthor(String author) {
        return books.stream()
                .filter(book -> book.getAuthor().toLowerCase().contains(author.toLowerCase()))
                .collect(Collectors.toList());
    }
    
    /**
     * Get all available books
     */
    public List<Book> getAvailableBooks() {
        return books.stream()
                .filter(Book::isAvailable)
                .collect(Collectors.toList());
    }
    
    /**
     * Borrow a book
     */
    public void borrowBook(String isbn, String userId) throws LibraryException {
        Book book = findBookByIsbn(isbn)
                .orElseThrow(() -> new LibraryException("Book not found: " + isbn));
        
        User user = findUserById(userId)
                .orElseThrow(() -> new LibraryException("User not found: " + userId));
        
        if (!book.isAvailable()) {
            throw new LibraryException("Book is not available: " + book.getTitle());
        }
        
        if (!user.canBorrowMore()) {
            throw new LibraryException("User has reached borrowing limit");
        }
        
        book.borrow(userId);
        user.addBorrowedBook(isbn);
        logger.info("User {} borrowed book {}", user.getName(), book.getTitle());
    }
    
    /**
     * Return a book
     */
    public void returnBook(String isbn) throws LibraryException {
        Book book = findBookByIsbn(isbn)
                .orElseThrow(() -> new LibraryException("Book not found: " + isbn));
        
        if (book.isAvailable()) {
            throw new LibraryException("Book was not borrowed: " + book.getTitle());
        }
        
        String userId = book.getBorrowedBy();
        User user = findUserById(userId)
                .orElseThrow(() -> new LibraryException("User not found: " + userId));
        
        book.returnBook();
        user.removeBorrowedBook(isbn);
        logger.info("User {} returned book {}", user.getName(), book.getTitle());
    }
    
    /**
     * Get statistics
     */
    public String getStatistics() {
        long totalBooks = books.size();
        long availableBooks = books.stream().filter(Book::isAvailable).count();
        long borrowedBooks = totalBooks - availableBooks;
        long totalUsers = users.size();
        
        return String.format(
            "Library Statistics:%n" +
            "Total Books: %d%n" +
            "Available: %d%n" +
            "Borrowed: %d%n" +
            "Total Users: %d",
            totalBooks, availableBooks, borrowedBooks, totalUsers
        );
    }
    
    // Getters
    public List<Book> getAllBooks() {
        return new ArrayList<>(books);
    }
    
    public List<User> getAllUsers() {
        return new ArrayList<>(users);
    }
}</code></pre>
                                        <div class="alert alert-info mt-3">
                                            <h6><i class="bi bi-lightbulb"></i> Key Points:</h6>
                                            <ul class="mb-0">
                                                <li><strong>Stream API:</strong> Modern Java 8+ collections processing</li>
                                                <li><strong>Optional:</strong> Better null handling for search operations</li>
                                                <li><strong>Business validation:</strong> Check book availability and user limits</li>
                                                <li><strong>Separation of concerns:</strong> Delegates storage to StorageService</li>
                                                <li><strong>Comprehensive logging:</strong> Track all operations</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Main Class -->
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#mainClass">
                                        <i class="bi bi-play-circle me-2"></i> <strong>Main.java - Application Entry Point</strong>
                                    </button>
                                </h2>
                                <div id="mainClass" class="accordion-collapse collapse" data-bs-parent="#codeExplanationsAccordion">
                                    <div class="accordion-body">
                                        <p>Main application demonstrating library operations.</p>
                                        <pre><code class="language-java">package com.library;

import com.library.exception.LibraryException;
import com.library.model.Book;
import com.library.model.User;
import com.library.service.LibraryService;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/**
 * Main application entry point
 */
public class Main {
    private static final Logger logger = LoggerFactory.getLogger(Main.class);
    
    public static void main(String[] args) {
        LibraryService library = new LibraryService();
        
        try {
            // Load existing data
            library.loadData();
            
            // Add sample books if library is empty
            if (library.getAllBooks().isEmpty()) {
                logger.info("Initializing library with sample data...");
                initializeSampleData(library);
            }
            
            // Display library statistics
            System.out.println("\n" + library.getStatistics());
            
            // Demonstrate operations
            demonstrateOperations(library);
            
            // Save data
            library.saveData();
            logger.info("Application completed successfully");
            
        } catch (LibraryException e) {
            logger.error("Application error", e);
            System.err.println("Error: " + e.getMessage());
        }
    }
    
    private static void initializeSampleData(LibraryService library) throws LibraryException {
        // Add books
        library.addBook(new Book("978-0134685991", "Effective Java", "Joshua Bloch", "Programming", 2018));
        library.addBook(new Book("978-0132350884", "Clean Code", "Robert Martin", "Programming", 2008));
        library.addBook(new Book("978-0201633610", "Design Patterns", "Gang of Four", "Programming", 1994));
        library.addBook(new Book("978-1449374648", "Maven: The Definitive Guide", "Sonatype", "Build Tools", 2008));
        library.addBook(new Book("978-0596009205", "Head First Java", "Kathy Sierra", "Programming", 2005));
        
        // Add users
        library.addUser(new User("U001", "Alice Johnson", "alice@example.com", "555-0101"));
        library.addUser(new User("U002", "Bob Smith", "bob@example.com", "555-0102"));
        library.addUser(new User("U003", "Carol White", "carol@example.com", "555-0103"));
        
        logger.info("Sample data initialized");
    }
    
    private static void demonstrateOperations(LibraryService library) throws LibraryException {
        System.out.println("\n=== Demonstrating Library Operations ===\n");
        
        // Search books
        System.out.println("Books by 'Java' in title:");
        library.searchBooksByTitle("Java").forEach(book -> 
            System.out.println("  - " + book.getTitle() + " by " + book.getAuthor()));
        
        // Borrow books
        System.out.println("\n=== Borrowing Operations ===");
        library.borrowBook("978-0134685991", "U001");
        System.out.println("Alice borrowed 'Effective Java'");
        
        library.borrowBook("978-0132350884", "U001");
        System.out.println("Alice borrowed 'Clean Code'");
        
        // Display available books
        System.out.println("\nAvailable books: " + library.getAvailableBooks().size());
        
        // Return a book
        System.out.println("\n=== Return Operations ===");
        library.returnBook("978-0134685991");
        System.out.println("Returned 'Effective Java'");
        
        // Final statistics
        System.out.println("\n" + library.getStatistics());
    }
}</code></pre>
                                        <div class="alert alert-info mt-3">
